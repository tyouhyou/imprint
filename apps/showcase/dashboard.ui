column id="dash_page" spacing=4 padding=6
  row spacing=6
    label text="FACTORY CONSOLE"
    label id="console_ppm" text="0000 u/min"
    button id="dash_back_btn" text="BACK" width=56
  row spacing=6
    gauge id="temp_gauge" min=0 max=200 value=120
    gauge id="press_gauge" min=0 max=200 value=150
    gauge id="flow_gauge" min=0 max=100 value=32
  label text="TREND / SETPOINT"
  trend id="trend" width=292 height=36
  row spacing=4
    knob id="setpoint_knob" min=0 max=100 value=40
    slider id="setpoint_slider" min=0 max=100 step=5 width=76
  row spacing=6
    label id="setpoint_value" text="40"
    label text="PUMP"
    toggle id="pump_toggle" checked=true
    label text="COOLANT"
    toggle id="coolant_toggle"
  row spacing=6
    button id="bench_btn" text="SELF-CHECK" width=68
    label id="bench_out" text="RT:0 PX/F:0 FPS:--" width=172